{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vogue.invalid/workflow/0.1/sales-market-review-request.schema.json",
  "title": "P08 → P07 full-Draft direct review",
  "$comment": "PROPOSED workflow-contract/0.2.0: structural validation plus versioned semantic rules are required; see decisions/contract-baseline.json. Not service compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "input"
  ],
  "properties": {
    "contract_version": {
      "const": "vogue-workflow/0.1"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_draft",
        "derived_view"
      ],
      "properties": {
        "planning_draft": {
          "$ref": "common.schema.json#/$defs/retained_draft"
        },
        "derived_view": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/derived_view"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
