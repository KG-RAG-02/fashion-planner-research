{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vogue.invalid/workflow/0.1/planning-draft-response.schema.json",
  "title": "P06 → P08 PlanningDraft envelope",
  "$comment": "PROPOSED workflow-contract/0.2.0: structural validation plus versioned semantic rules are required; see decisions/contract-baseline.json. Not service compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "producer",
    "status",
    "result"
  ],
  "properties": {
    "contract_version": {
      "const": "vogue-workflow/0.1"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "schema_version"
      ],
      "properties": {
        "agent_id": {
          "const": "new-product-agent"
        },
        "schema_version": {
          "const": "planning-draft/1.0"
        }
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "agent_id",
        "request_id",
        "status",
        "draft_identity",
        "draft",
        "source_request",
        "source_request_sha256",
        "limitations",
        "errors",
        "artifacts",
        "image_generation_calls",
        "review_calls"
      ],
      "properties": {
        "schema_version": {
          "const": "planning-draft/1.0"
        },
        "agent_id": {
          "const": "new-product-agent"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "draft_identity": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/draft_identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "draft": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/draft"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_request": {
          "$ref": "planning-draft-request.schema.json"
        },
        "source_request_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "limitations": {
          "$ref": "common.schema.json#/$defs/strings"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/error"
          },
          "minItems": 0
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/json_artifact"
          },
          "minItems": 0
        },
        "image_generation_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "review_calls": {
          "const": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "partial"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "draft_identity": {
                "$ref": "common.schema.json#/$defs/draft_identity"
              },
              "draft": {
                "$ref": "common.schema.json#/$defs/draft"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "no_results",
                  "error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "draft_identity": {
                "type": "null"
              },
              "draft": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "errors": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/error"
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "no_results"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "limitations": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_request": {
                "properties": {
                  "input": {
                    "properties": {
                      "mode": {
                        "const": "draft_only"
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "image_generation_calls": {
                "const": 0
              },
              "draft": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "not": {
                      "required": [
                        "visuals"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              },
              "source_request": {
                "properties": {
                  "input": {
                    "properties": {
                      "mode": {
                        "const": "draft_with_visuals"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "draft": {
                "required": [
                  "visuals"
                ],
                "properties": {
                  "visuals": {
                    "properties": {
                      "product": {
                        "properties": {
                          "status": {
                            "const": "generated"
                          }
                        }
                      },
                      "outfit": {
                        "properties": {
                          "status": {
                            "const": "generated"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
