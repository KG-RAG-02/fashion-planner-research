              "artifact": {
                "type": "null"
              },
              "lineage": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "provider_calls": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
