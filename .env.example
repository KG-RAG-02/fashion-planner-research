# 복사해서 .env로 쓰고 값을 채웁니다. .env는 커밋하지 않습니다.
# 설명: README.md의 '설정' 절

# 서비스 토큰(필수). 리뷰 경로의 Bearer 토큰입니다.
FASHION_PLANNER_SERVICE_TOKEN=

# synthetic이면 네트워크 없이 합성 자료로 리뷰합니다.
RESEARCH_REVIEW_SOURCE=

# 동의가 필요한 동작. 기본은 꺼짐이며 true로 켭니다.
RESEARCH_HM_NONCOMMERCIAL_RESEARCH=
RESEARCH_TARGET_LLM_TRANSFER_AUTHORIZED=

# 타깃 고객 가설용 LLM(OpenAI Responses API)
LLM_API_KEY=
LLM_MODEL=

# 읽기 전용 객체 저장소(Cloudflare R2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# 미리 만든 집계 스냅샷의 객체 키
RESEARCH_AGGREGATE_SNAPSHOT_KEY=
