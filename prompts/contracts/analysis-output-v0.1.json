{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings", "limitations", "missing_data"],
  "properties": {
    "status": {"type": "string", "enum": ["ok", "partial", "no_results", "error"]},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "statement", "kind", "evidence_ids"],
        "properties": {
          "finding_id": {"type": "string"},
          "statement": {"type": "string"},
          "kind": {"type": "string", "enum": ["fact", "interpretation", "hypothesis", "limitation"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "missing_data": {"type": "array", "items": {"type": "string"}}
  }
}
