{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vogue:orchestration-request:0.1-proposal",
  "title": "Canonical orchestration request for Project_07 (proposal)",
  "description": "Unratified input proposal. This is not the agreed vogue-handoff/0.1 request schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "request_id", "created_at", "locale", "timezone",
    "raw_query", "query_parser", "intent", "scope", "requested_agents"
  ],
  "properties": {
    "contract_version": {"const": "vogue-orchestration-request/0.1-proposal"},
    "request_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "locale": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "raw_query": {"type": "string", "minLength": 1},
    "query_parser": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "reference_time"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "reference_time": {"type": "string", "format": "date-time"}
      }
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "requested_action", "confidence"],
      "properties": {
        "primary": {"enum": ["sales_observation", "market_observation", "mapping_lookup", "definition_lookup", "product_opportunity_research", "unsupported"]},
        "requested_action": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "scope": {"$ref": "#/$defs/scope"},
    "requested_agents": {
      "type": "array", "uniqueItems": true, "minItems": 1,
      "items": {"enum": ["trend", "inventory", "sales_market"]},
      "contains": {"const": "sales_market"}
    }
  },
  "$defs": {
    "scope_value": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "certainty", "source"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "certainty": {"enum": ["explicit", "inferred", "defaulted"]},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "period": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "certainty", "rule_version", "source"],
      "properties": {
        "start": {"type": ["string", "null"], "format": "date"},
        "end": {"type": ["string", "null"], "format": "date"},
        "certainty": {"enum": ["resolved", "unresolved"]},
        "rule_version": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"certainty": {"const": "resolved"}}},
          "then": {"properties": {"start": {"type": "string"}, "end": {"type": "string"}, "rule_version": {"type": "string"}, "source": {"type": "string"}}}
        },
        {
          "if": {"properties": {"certainty": {"const": "unresolved"}}},
          "then": {"properties": {"start": {"type": "null"}, "end": {"type": "null"}}}
        }
      ]
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "gender", "season", "period", "geography", "channel", "metrics", "ambiguities"],
      "properties": {
        "category": {"oneOf": [{"$ref": "#/$defs/scope_value"}, {"type": "null"}]},
        "gender": {"oneOf": [{"$ref": "#/$defs/scope_value"}, {"type": "null"}]},
        "season": {"oneOf": [{"$ref": "#/$defs/scope_value"}, {"type": "null"}]},
        "period": {"$ref": "#/$defs/period"},
        "geography": {"oneOf": [{"$ref": "#/$defs/scope_value"}, {"type": "null"}]},
        "channel": {"oneOf": [{"$ref": "#/$defs/scope_value"}, {"type": "null"}]},
        "metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ambiguities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
