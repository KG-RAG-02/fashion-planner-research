{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vogue:proposals:project-07:market-research-result:1.1-draft",
  "title": "MarketResearchResult (Project_07 proposal draft; not a shared contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "agent_id",
    "status",
    "summary",
    "findings",
    "evidence",
    "limitations",
    "errors",
    "sales_data",
    "data_limitations",
    "proposal"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1-proposal"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "const": "market-research-agent"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "no_results",
        "error"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "sales_data": {
      "anyOf": [
        {"$ref": "#/$defs/sales_data"},
        {"type": "null"}
      ]
    },
    "data_limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/data_limitation"
      }
    },
    "proposal": {
      "anyOf": [
        {"$ref": "#/$defs/proposal"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "required": ["format", "request_id", "concept", "trend_analysis", "historical_sales", "market_viability", "competitor_benchmark", "inventory_and_production", "design_brief", "ai_visualization", "limitations"],
      "properties": {
        "format": {"const": "merchandising_proposal_dashboard"},
        "request_id": {"type": "string"},
        "concept": {"type": "object"},
        "trend_analysis": {"type": "object"},
        "historical_sales": {"type": "object"},
        "market_viability": {"type": "object"},
        "competitor_benchmark": {"type": "object"},
        "inventory_and_production": {"type": "object"},
        "design_brief": {"type": "object"},
        "ai_visualization": {"type": "object"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sales_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observations", "limitations", "errors", "follow_up_questions"],
      "properties": {
        "status": {"enum": ["ok", "partial", "no_results", "error"]},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/sales_observation"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}},
        "follow_up_questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sales_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id", "metric_name", "value", "unit", "evidence_ids",
        "product_id", "category", "period_start", "period_end", "as_of",
        "geography", "channel", "currency", "metric_definition", "product_mapping"
      ],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "metric_name": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "product_id": {"type": ["string", "null"]},
        "category": {"type": ["string", "null"]},
        "period_start": {"type": ["string", "null"]},
        "period_end": {"type": ["string", "null"]},
        "as_of": {"type": ["string", "null"]},
        "geography": {"type": ["string", "null"]},
        "channel": {"type": ["string", "null"]},
        "currency": {"type": ["string", "null"]},
        "metric_definition": {"type": ["string", "null"]},
        "product_mapping": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "topic",
        "statement",
        "kind",
        "evidence_ids",
        "related_concept_ids"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "fact",
            "interpretation",
            "hypothesis",
            "proposal"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "related_concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "source_type",
        "source_name",
        "locator",
        "published_at",
        "observed_at",
        "fetched_at",
        "permission_status",
        "manifest_id",
        "period_start",
        "period_end",
        "as_of",
        "geography",
        "channel",
        "product_mapping",
        "unit",
        "currency",
        "metric_definition",
        "calculation_reference"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "fetched_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "permission_status": {
          "const": "authorized"
        },
        "manifest_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "period_start": {
          "type": [
            "string",
            "null"
          ]
        },
        "period_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "geography": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_mapping": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "metric_definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "calculation_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "data_limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "evidence_ids",
        "field"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
