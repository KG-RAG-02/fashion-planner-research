{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vogue:synthetic-rag-analysis:0.2-proposal",
  "title": "Synthetic RAG simulation analysis response with calculations (proposal)",
  "description": "Local authenticated synthetic simulation API response. This is not the agreed vogue-handoff/0.1 result contract and must not be interpreted as real market or sales evidence.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "status", "execution_mode", "simulation_mode", "synthetic",
    "data_nature", "permission_status", "operational_eligible", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "synthetic-rag-analysis/0.2-proposal"},
    "request_id": {"type": ["string", "null"]},
    "status": {"enum": ["ok", "partial", "no_results", "error"]},
    "reason": {"type": ["string", "null"]},
    "message": {"type": "string"},
    "execution_mode": {"const": "synthetic_test"},
    "simulation_mode": {"const": "synthetic_simulation"},
    "synthetic": {"const": true},
    "data_nature": {"const": "synthetic_test"},
    "permission_status": {"const": "authorized_for_synthetic_testing_only"},
    "operational_eligible": {"const": false},
    "requested_scope": {"type": "object"},
    "source_manifests": {
      "type": "object",
      "properties": {
        "observations": {"type": ["object", "null"]},
        "explanatory_documents": {"type": ["object", "null"]},
        "r2_release": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["schema_version", "release_id", "manifest_key", "manifest_sha256", "runtime_objects"],
              "properties": {
                "schema_version": {"const": "project07-synthetic-r2-bundle/1.0"},
                "release_id": {"type": "string"},
                "source_commit": {"type": ["string", "null"]},
                "manifest_key": {"type": "string"},
                "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "runtime_objects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["dataset_group", "relative_path", "object_key", "size_bytes", "sha256"],
                    "properties": {
                      "dataset_group": {"enum": ["runtime/query_coverage", "runtime/market_scenario"]},
                      "relative_path": {"type": "string"},
                      "object_key": {"type": "string"},
                      "size_bytes": {"type": "integer", "minimum": 0},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "market_like": {"$ref": "#/$defs/data_block"},
    "sales_like": {"$ref": "#/$defs/data_block"},
    "retrieval": {"type": "object"},
    "analysis": {"type": "object"},
    "comparability": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "data_block": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "calculations": {"type": "array", "items": {"$ref": "#/$defs/calculation"}},
        "calculation_limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "calculation_id", "metric_name", "value", "unit", "formula_id", "formula_version",
        "baseline_period", "current_period", "input_observation_ids", "evidence_ids", "dimensions",
        "synthetic", "data_nature", "permission_status", "operational_eligible"
      ],
      "properties": {
        "calculation_id": {"type": "string", "minLength": 1},
        "metric_name": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"const": "percent"},
        "formula_id": {"const": "adjacent_month_relative_change_percent"},
        "formula_version": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1},
        "baseline_period": {"type": "string"},
        "current_period": {"type": "string"},
        "baseline_value": {"type": "number"},
        "current_value": {"type": "number"},
        "input_unit": {"type": "string"},
        "input_observation_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dimensions": {"type": "object"},
        "synthetic": {"const": true},
        "data_nature": {"const": "synthetic_test"},
        "permission_status": {"const": "authorized_for_synthetic_testing_only"},
        "operational_eligible": {"const": false}
      }
    }
  }
}
