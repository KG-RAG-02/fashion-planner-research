{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vogue:sales-market-review:0.1:proposal-response",
  "title": "Project_07 internal PlanningDraft review proposal response",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "producer", "status", "result"],
  "properties": {
    "contract_version": {"const": "vogue-sales-market-review/0.1-proposal"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "schema_version"],
      "properties": {
        "agent_id": {"const": "sales-market-agent"},
        "schema_version": {"const": "sales-market-review/0.1-internal"}
      }
    },
    "status": {"enum": ["ok", "partial", "no_results", "error"]},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "draft_id", "producer_id", "status", "draft_context", "category_price_comparison", "material_cost_analysis", "customer_segment_analysis", "target_audience_analysis", "margin_estimate", "evidence", "missing_data", "errors", "limitations", "decision_support", "price_analysis", "fabric_cost_analysis", "margin_analysis", "target_audience"],
      "properties": {
        "schema_version": {"const": "sales-market-review/0.1-internal"},
        "request_id": {"type": "string"},
        "draft_id": {"type": ["string", "null"]},
        "producer_id": {"const": "sales-market-agent"},
        "status": {"enum": ["ok", "partial", "no_results", "error"]},
        "draft_context": {"type": "object"},
        "category_price_comparison": {"type": "array"},
        "material_cost_analysis": {"type": "array"},
        "customer_segment_analysis": {"type": "array"},
        "target_audience_analysis": {"type": "object"},
        "margin_estimate": {"type": "object"},
        "evidence": {"type": "array"},
        "missing_data": {"type": "array"},
        "errors": {"type": "array"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "decision_support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recommendation", "ready_for_human_decision", "evidence_areas", "human_decision_required"],
          "properties": {
            "recommendation": {"const": "review_required"},
            "ready_for_human_decision": {"type": "boolean"},
            "evidence_areas": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category_price", "material_cost", "margin", "customer_segments"],
              "properties": {
                "category_price": {"type": "boolean"},
                "material_cost": {"type": "boolean"},
                "margin": {"type": "boolean"},
                "customer_segments": {"type": "boolean"}
              }
            },
            "human_decision_required": {"const": true}
          }
        },
        "price_analysis": {"type": "object"},
        "fabric_cost_analysis": {"type": "object"},
        "margin_analysis": {"type": "object"},
        "target_audience": {"type": "object"}
      }
    }
  }
}
