{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vogue:handoff:0.1:project-07:request",
  "title": "VOGUE handoff v0.1 Project_07 run request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "input"],
  "properties": {
    "contract_version": {"const": "vogue-handoff/0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "input": {"$ref": "#/$defs/input"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "planning_request", "trend_result", "inventory_product_result"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "planning_request": {
          "type": "object",
          "required": ["request_id", "schema_version"],
          "properties": {
            "request_id": {"type": "string", "minLength": 1},
            "schema_version": {"const": "1.0"}
          },
          "additionalProperties": true
        },
        "trend_result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/trend_result"}]},
        "inventory_product_result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/inventory_result"}]},
        "requested_category": {"type": ["string", "null"]},
        "requested_metrics": {"type": "array", "items": {"type": "string"}},
        "requested_geography": {"type": ["string", "null"]},
        "requested_channel": {"type": ["string", "null"]},
        "requested_query": {"type": ["string", "null"]},
        "requested_period": {"type": ["string", "null"]},
        "requested_population": {"type": ["string", "null"]},
        "requested_unit": {"type": ["string", "null"]},
        "requested_currency": {"type": ["string", "null"]},
        "requested_measure_type": {"type": ["string", "null"]},
        "requested_mapping_id": {"type": ["string", "null"]},
        "requested_mapping_version": {"type": ["string", "null"]},
        "requested_period_grain": {"type": ["string", "null"]},
        "requested_document_version": {"type": ["string", "null"]}
      }
    },
    "trend_result": {
      "type": "object",
      "required": ["request_id", "status"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "schema_version": {"enum": ["1.0", "1.1"]},
        "status": {"enum": ["ok", "partial", "no_results", "error"]}
      },
      "additionalProperties": true
    },
    "inventory_result": {
      "type": "object",
      "required": ["request_id", "status"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "schema_version": {"enum": ["1.0"]},
        "status": {"enum": ["ok", "partial", "no_results", "error"]}
      },
      "additionalProperties": true
    }
  }
}
