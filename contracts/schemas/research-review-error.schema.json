{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fashion-planner.invalid/research/research-review-error.schema.json",
  "title": "research review request/service error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "error"
  ],
  "properties": {
    "contract_version": {
      "const": "research-handoff"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
