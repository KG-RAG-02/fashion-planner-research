{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vogue:handoff:0.1:project-07:error",
  "title": "VOGUE handoff v0.1 transport error",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "error"],
  "properties": {
    "contract_version": {"const": "vogue-handoff/0.1"},
    "request_id": {"type": ["string", "null"]},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
