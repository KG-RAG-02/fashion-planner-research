# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local environment and secrets; keep checked-in examples/templates
.env
.env.*
!.env.example
!.env.*.example

# Test, lint, and type-check output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Packaging and build output
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Local logs and temporary files
*.log
*.tmp
*.temp

# Local databases and DuckDB spill files
*.db
*.sqlite
*.sqlite3
*.duckdb
*.duckdb.wal

# Runtime datasets, derived files, and machine-local state
/data/raw/
/data/interim/
/data/processed/
/data/local/

# Operating system files
.DS_Store
Thumbs.db

# Deterministic test outputs: python scripts/restore_test_fixtures.py
/examples/query_coverage/generated/
/examples/synthetic_market_scenario/generated/
/tests/fixtures/synthetic_market_rag/
/.local/

# iCloud Drive conflict copies (e.g. "server 2.py"); never commit them.
* [0-9]
* [0-9].*
# restore_test_fixtures.py also writes these deterministic files; they are regenerated, not committed.
/examples/query_coverage/config.json
/examples/synthetic_market_scenario/scenario-config.json
/examples/fixtures/http_json_handoff/
/examples/synthetic_rag_analysis/
/tests/fixtures/upstream-envelope.synthetic.json
